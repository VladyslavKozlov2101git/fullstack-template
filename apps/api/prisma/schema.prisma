generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Replace with the real domain. Here so `prisma migrate dev` has something to do.
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  // scrypt digest, never the plaintext. Format and parameters: src/auth/password.ts.
  // Omitted from every query by default — see PrismaService.
  password  String
  name      String?
  createdAt DateTime @default(now())
}
