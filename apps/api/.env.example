DATABASE_URL="postgresql://app:app@localhost:5432/app?schema=public"
PORT=3000

# Signing key for the session JWT. Generate one: openssl rand -hex 32
JWT_SECRET=""
# Drives both the token lifetime and the cookie maxAge.
JWT_TTL_DAYS=7
# Anything other than "development" makes the session cookie Secure, which is
# the right default for a deployment but breaks login over plain-http localhost.
NODE_ENV=development

# Comma-separated addresses allowed into the admin panel at /api/admin. Matched
# case-insensitively against User.email. Empty or unset admits nobody, which is
# the safe default for a fresh deployment — the panel is useless, not open.
ADMIN_EMAILS=""
# Signs the panel's own session cookie, which is separate from the app session.
# Generate one: openssl rand -hex 32
ADMIN_SESSION_SECRET=""
