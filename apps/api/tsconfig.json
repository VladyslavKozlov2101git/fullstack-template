{
  "compilerOptions": {
    "module": "node20",
    // Required by ts-jest once the module kind is node20; it also keeps every file
    // independently transpilable, which is what the Nest build already assumes.
    "isolatedModules": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "sourceMap": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true
  },
  "include": ["src/**/*"]
}
