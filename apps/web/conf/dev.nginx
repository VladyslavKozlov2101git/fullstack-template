# Static hosting for the built SPA + a reverse proxy so the API is same-origin
# (which is what makes /api work without CORS). Copy, set server_name and root.
server {
    listen 80;
    server_name example.com;

    client_max_body_size 0;
    charset utf-8;

    index index.html;
    root /var/www/app/dist;

    access_log /var/log/nginx/app_access.log;
    error_log /var/log/nginx/app_error.log;

    # OWASP A05 — security headers. Tighten the CSP once you know your real origins.
    add_header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;
    # Serve over TLS and add: add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /api/ {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # The AdminJS panel. It is served by the API, not from `root`, so without
    # this block `location /` would hand out index.html and the panel would be
    # unreachable.
    #
    # A regex location matching the segment exactly, rather than the prefix
    # `/admin`: the entry URL is /admin with no trailing slash, so `/admin/`
    # alone would miss it, while a bare `/admin` prefix would also swallow
    # /administrator and any future /admin-something SPA route.
    #
    # Put an access proxy (Cloudflare Access, Tailscale, a VPN) in front of this
    # path before exposing it. The panel has its own login and a 5-per-5-minutes
    # retry limit, but it is a full read/write interface to the database and
    # should not be the only thing standing between the internet and the data.
    #
    # Every security header from the server level is repeated here. nginx
    # inherits add_header only when the current level declares none, so setting
    # the CSP alone would silently drop nosniff, Referrer-Policy and
    # Permissions-Policy on exactly the path that needs them most.
    location ~ ^/admin(/|$) {
        # Two relaxations against the server-level policy, both measured against
        # the real panel rather than guessed:
        #   script-src 'unsafe-inline' — AdminJS inlines two scripts in its page,
        #     one assigning window.REDUX_STATE and one calling createRoot. Under
        #     a plain 'self' the panel loads and renders blank. It ships no nonce
        #     support, so there is no narrower form of this.
        #   fonts.googleapis.com / fonts.gstatic.com — its design system loads
        #     Roboto from Google Fonts.
        # Both apply to this path only; the SPA keeps the strict policy above.
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), camera=(), microphone=()" always;

        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html?$args;
    }
}
