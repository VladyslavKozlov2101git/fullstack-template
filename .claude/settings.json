{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./**/dist/**)",
      "Read(./**/.turbo/**)",
      "Read(./**/node_modules/**)",
      "Read(./.env)",
      "Read(./**/.env)",
      "Edit(./**/dist/**)",
      "Edit(./**/.turbo/**)",
      "Edit(./packages/api-client/src/schema.d.ts)",
      "Edit(./pnpm-lock.yaml)",
      "Edit(./apps/api/prisma/migrations/**)"
    ],
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm test:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm typecheck:*)",
      "Bash(pnpm --filter:*)",
      "Bash(docker compose:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ]
  }
}
